{
  "schema_version": 1,
  "application": {
    "id": "company-application-demo",
    "version": "1.0.0",
    "valid_from": "2026-01-01",
    "valid_to": null,
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "company.name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "company.reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "representative.name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "contact.name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "contact.email": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "format": "email"
        },
        "application.date": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "format": "date"
        },
        "application.reservation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "application.certificate": {
          "type": "boolean"
        },
        "company.branches": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "address": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "name",
              "address"
            ]
          }
        },
        "capital.first": {
          "type": "integer",
          "minimum": 0
        },
        "capital.second": {
          "type": "integer",
          "minimum": 0
        },
        "capital.total": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "company.name",
        "company.reference",
        "representative.name",
        "contact.name",
        "contact.email",
        "application.date",
        "application.reservation",
        "application.certificate",
        "company.branches",
        "capital.first",
        "capital.second",
        "capital.total"
      ]
    },
    "fields": {
      "company.name": {
        "role": "company",
        "predicate": "legal_name",
        "require_verification_event": false
      },
      "company.reference": {
        "role": "company",
        "predicate": "registration_reference",
        "require_verification_event": false
      },
      "representative.name": {
        "role": "representative",
        "predicate": "name",
        "require_verification_event": true
      },
      "contact.name": {
        "role": "contact",
        "predicate": "name",
        "require_verification_event": false
      },
      "contact.email": {
        "role": "contact",
        "predicate": "email",
        "require_verification_event": false
      },
      "application.date": {
        "role": "company",
        "predicate": "application_date",
        "require_verification_event": false
      },
      "application.reservation": {
        "role": "company",
        "predicate": "reservation_number",
        "require_verification_event": false
      },
      "application.certificate": {
        "role": "company",
        "predicate": "include_certificate",
        "require_verification_event": false
      },
      "company.branches": {
        "role": "company",
        "predicate": "branches",
        "require_verification_event": false
      },
      "capital.first": {
        "role": "company",
        "predicate": "first_contribution",
        "require_verification_event": false
      },
      "capital.second": {
        "role": "company",
        "predicate": "second_contribution",
        "require_verification_event": false
      },
      "capital.total": {
        "role": "company",
        "predicate": "capital_total",
        "require_verification_event": false
      }
    },
    "rules": [
      {
        "id": "representation",
        "version": "1",
        "source": "fixture-policy: representation required for this demo",
        "check": {
          "kind": "relationship",
          "from_role": "representative",
          "to_role": "company",
          "relation": "represents"
        }
      },
      {
        "id": "capital-sum",
        "version": "1",
        "source": "fixture-policy: exact integer TWD totals",
        "check": {
          "kind": "sum",
          "fields": [
            "capital.first",
            "capital.second"
          ],
          "total": "capital.total",
          "unit": "TWD"
        }
      },
      {
        "id": "certificate-email",
        "version": "1",
        "source": "fixture-policy: certificate contact required",
        "check": {
          "kind": "required_when",
          "condition": {
            "op": "equals",
            "field": "application.certificate",
            "value": true
          },
          "field": "contact.email"
        }
      }
    ],
    "documents": [
      {
        "id": "01-overview",
        "template": "cover",
        "condition": {
          "op": "always"
        },
        "repeat_field": null,
        "bindings": {
          "company": {
            "source": {
              "kind": "field",
              "field": "company.name"
            },
            "transform": {
              "kind": "identity"
            }
          },
          "number": {
            "source": {
              "kind": "field",
              "field": "company.reference"
            },
            "transform": {
              "kind": "identity"
            }
          },
          "representative": {
            "source": {
              "kind": "field",
              "field": "representative.name"
            },
            "transform": {
              "kind": "identity"
            }
          },
          "contact": {
            "source": {
              "kind": "field",
              "field": "contact.name"
            },
            "transform": {
              "kind": "identity"
            }
          },
          "date": {
            "source": {
              "kind": "field",
              "field": "application.date"
            },
            "transform": {
              "kind": "identity"
            }
          },
          "certificate": {
            "source": {
              "kind": "field",
              "field": "application.certificate"
            },
            "transform": {
              "kind": "identity"
            }
          }
        }
      },
      {
        "id": "02-official-form",
        "template": "official",
        "condition": {
          "op": "always"
        },
        "repeat_field": null,
        "bindings": {
          "reservation": {
            "source": {
              "kind": "field",
              "field": "application.reservation"
            },
            "transform": {
              "kind": "identity"
            }
          },
          "representative": {
            "source": {
              "kind": "field",
              "field": "representative.name"
            },
            "transform": {
              "kind": "identity"
            }
          },
          "email": {
            "source": {
              "kind": "field",
              "field": "contact.email"
            },
            "transform": {
              "kind": "identity"
            }
          }
        }
      },
      {
        "id": "03-certificate",
        "template": "certificate",
        "condition": {
          "op": "equals",
          "field": "application.certificate",
          "value": true
        },
        "repeat_field": null,
        "bindings": {
          "company": {
            "source": {
              "kind": "field",
              "field": "company.name"
            },
            "transform": {
              "kind": "uppercase"
            }
          },
          "contact": {
            "source": {
              "kind": "field",
              "field": "contact.name"
            },
            "transform": {
              "kind": "identity"
            }
          },
          "email": {
            "source": {
              "kind": "field",
              "field": "contact.email"
            },
            "transform": {
              "kind": "identity"
            }
          }
        }
      },
      {
        "id": "04-branch",
        "template": "branch",
        "condition": {
          "op": "always"
        },
        "repeat_field": "company.branches",
        "bindings": {
          "company": {
            "source": {
              "kind": "field",
              "field": "company.name"
            },
            "transform": {
              "kind": "identity"
            }
          },
          "branch": {
            "source": {
              "kind": "item",
              "pointer": "/name"
            },
            "transform": {
              "kind": "identity"
            }
          },
          "address": {
            "source": {
              "kind": "item",
              "pointer": "/address"
            },
            "transform": {
              "kind": "identity"
            }
          }
        }
      }
    ]
  },
